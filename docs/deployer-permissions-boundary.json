{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowRuntimeIdentityAndBillingRead",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "billing:GetCredits",
        "billing:GetBillingPreferences",
        "ce:ListCostCategoryDefinitions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowRuntimeCostCategoryDescribe",
      "Effect": "Allow",
      "Action": "ce:DescribeCostCategoryDefinition",
      "Resource": "arn:aws:ce::<ACCOUNT_ID>:costcategory/*"
    },
    {
      "Sid": "AllowRuntimeOrganizationsAccountNames",
      "Effect": "Allow",
      "Action": "organizations:ListAccounts",
      "Resource": "*"
    },
    {
      "Sid": "AllowRuntimeLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/lambda/aws-credits-reporter*",
        "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/lambda/aws-credits-reporter*:*"
      ]
    },
    {
      "Sid": "AllowRuntimeSnapshotObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::<SNAPSHOT_BUCKET_NAME>/snapshots/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<ACCOUNT_ID>"
        }
      }
    },
    {
      "Sid": "AllowRuntimeSnapshotList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<SNAPSHOT_BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": "snapshots/*"
        },
        "StringEquals": {
          "aws:ResourceAccount": "<ACCOUNT_ID>"
        }
      }
    },
    {
      "Sid": "AllowRuntimeSnsPublish",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:<REGION>:<ACCOUNT_ID>:aws-credits-reporter*"
    },
    {
      "Sid": "DenyIamUsersKeysAndCredentials",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:*AccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:CreateServiceSpecificCredential",
        "iam:AttachUserPolicy",
        "iam:PutUserPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyIamRoleAndPolicyChanges",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyBoundaryAssignmentChanges",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutUserPermissionsBoundary",
        "iam:DeleteUserPermissionsBoundary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOrganizationAndAccountChanges",
      "Effect": "Deny",
      "Action": [
        "organizations:Accept*",
        "organizations:Attach*",
        "organizations:Cancel*",
        "organizations:Close*",
        "organizations:Create*",
        "organizations:Decline*",
        "organizations:Delete*",
        "organizations:Deregister*",
        "organizations:Detach*",
        "organizations:Disable*",
        "organizations:Enable*",
        "organizations:Invite*",
        "organizations:Leave*",
        "organizations:Move*",
        "organizations:Put*",
        "organizations:Register*",
        "organizations:Remove*",
        "organizations:Tag*",
        "organizations:Untag*",
        "organizations:Update*",
        "account:*"
      ],
      "Resource": "*"
    }
  ]
}
