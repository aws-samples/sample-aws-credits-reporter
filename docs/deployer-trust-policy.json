{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MfaFlagOnlyForIamUsersNotFederatedSessions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "<DEPLOYER_PRINCIPAL>"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
