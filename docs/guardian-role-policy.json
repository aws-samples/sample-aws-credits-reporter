{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndResetBoundaryPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:policy/aws-credits-reporter-runtime-boundary"
    },
    {
      "Sid": "ReadExecutionRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<FUNCTION_NAME>-role"
    },
    {
      "Sid": "ReattachApprovedBoundaryOnly",
      "Effect": "Allow",
      "Action": "iam:PutRolePermissionsBoundary",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<FUNCTION_NAME>-role",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<ACCOUNT_ID>:policy/aws-credits-reporter-runtime-boundary"
        }
      }
    },
    {
      "Sid": "PublishAlert",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:<REGION>:<ACCOUNT_ID>:<FUNCTION_NAME>-alarms"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/lambda/<FUNCTION_NAME>-guardian:*"
    }
  ]
}
