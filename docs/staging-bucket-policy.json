{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::<CODE_STAGING_BUCKET>",
        "arn:aws:s3:::<CODE_STAGING_BUCKET>/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyCodeZipWritesExceptDeployerAndAdmin",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<CODE_STAGING_BUCKET>/lambda/*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::<ACCOUNT_ID>:role/aws-credits-reporter-deployer",
            "<ADMIN_ROLE_ARN_PATTERN>"
          ]
        }
      }
    }
  ]
}
